# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS / Caddy reverse-proxy (production)
# DOMAIN=news.example.com
# CSRF_TRUSTED_ORIGINS=https://news.example.com
# BEHIND_PROXY=True

# Database (SQLite for dev; switch to postgres for prod)
DATABASE_URL=sqlite:///db.sqlite3
# For docker-compose (matches POSTGRES_* defaults), use:
# DATABASE_URL=postgres://newsroom:newsroom@db:5432/newsroom

# Postgres credentials used by docker-compose (db service)
# POSTGRES_DB=newsroom
# POSTGRES_USER=newsroom
# POSTGRES_PASSWORD=newsroom

# Field encryption (django-encrypted-model-fields)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# LLM providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default rewriter provider: anthropic | openai
REWRITE_PROVIDER=anthropic

# Featured images from a stock photo bank: none | pexels
IMAGE_PROVIDER=none
PEXELS_API_KEY=

# User-Agent for downloading article pages (text extraction)
# EXTRACT_USER_AGENT=Mozilla/5.0 (compatible; NewsRewriter/1.0; +https://example.com/bot)
